<Project Sdk="Microsoft.NET.Sdk">

  <!-- ReChest's installer / updater / uninstaller. .NET Framework 4.8 (in every Windows 10/11) so it runs before
       anything is installed; the UI is setup.html in WebView2. build.ps1 appends the app (payload.zip) to the exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ReChestSetup</AssemblyName>
    <RootNamespace>ReChestSetup</RootNamespace>
    <StartupObject>ReChestSetup.Program</StartupObject>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Version>2.0.0</Version> <!-- build.ps1 passes ChestCounter.csproj's version -->
    <Product>ReChest</Product>
    <AssemblyTitle>ReChest Setup</AssemblyTitle>
    <DebugType>none</DebugType>
    <!-- build.ps1's output (the published .NET 10 app) must not look like references to this project -->
    <DefaultItemExcludes>$(DefaultItemExcludes);out\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" GeneratePathProperty="true" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- one exe: the page and WebView2's libraries ride inside it (Program.cs loads them) -->
    <EmbeddedResource Include="setup.html" LogicalName="setup.html" />
    <EmbeddedResource Include="..\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll" LogicalName="Microsoft.Web.WebView2.Core.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Wpf.dll" LogicalName="Microsoft.Web.WebView2.Wpf.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="WebView2Loader.dll" />
  </ItemGroup>

</Project>
